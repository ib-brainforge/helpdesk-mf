{
  "name": "helpdesk-mf",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "reset": "npx rimraf node_modules ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "build:production": "NODE_ENV=production modern build",
    "deploy": "modern deploy",
    "start": "modern start",
    "serve": "modern serve",
    "new": "modern new",
    "lint": "biome check",
    "prepare": "simple-git-hooks",
    "upgrade": "modern upgrade",
    "dev:with-packages": "echo \"Start package servers first, then run: npm run dev\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:allure:generate": "allure generate allure-results --clean -o allure-report --single-file",
    "test:e2e:allure:open": "allure open allure-report",
    "test:e2e:allure:serve": "allure serve allure-results"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
