OIDC_AUTHORITY=https://auth.dev.netcorp360.com/realms/dev
OIDC_CLIENT_ID=platform
# Uncomment when running embedded in the app shell / to mirror deployed. Not
# actually required even then: @brainforgeau/security's FlexibleAuthProvider
# rebinds this to the browser's current origin at runtime in standalone mode,
# and shell-embedded mode never initializes its own OIDC provider at all (it
# reads the shell's auth-bus state instead) — see README's Mode A/B notes.
# Kept here as the fleet-standard commented pair for consistency, not because
# leaving the localhost value active would break anything.
#OIDC_REDIRECT_URI=https://dev.netcorp360.com/helpdesk
OIDC_REDIRECT_URI=http://localhost:8087
OIDC_SCOPE=openid profile email
# ── Runtime config contract: named per-service URLs ───────────────────────────
# See infra docs/runtime-config/README.md. Every backend URL helpdesk-mf talks
# to is its own explicitly named key: <SERVICE>_API_BASE_URL <-> <service>ApiBaseUrl.
# Nothing is derived from anything else.
#
# These are the LOCAL DEV source of truth. They are baked into
# __HELPDESK_CONFIG__ by modern.config.ts and read as the `baked` half of
# `rc ?? baked`. When deployed, the shell's window.__RUNTIME_CONFIG__ wins and
# these are absent from the image entirely (the Dockerfile build stage pins them
# empty on purpose, so no build-time value leaks across environments).
#
# Absolute URLs, always. Same-origin in prod, so nothing changes there; explicit
# enough that local dev can point each service at a different environment.

# helpdesk-mf's own backend is not special — it gets a named key like any other.
HELPDESK_API_BASE_URL=https://dev.netcorp360.com/backend/helpdesk
NOTIFICATION_API_BASE_URL=https://dev.netcorp360.com/backend/notification
# identity-management lives on the AUTH host, not the app host. This is exactly
# the URL that cannot be derived from the app origin.
IDENTITY_API_BASE_URL=https://auth.dev.netcorp360.com/identity
TELEMETRY_API_BASE_URL=https://dev.netcorp360.com/backend/telemetry
ASSET_API_BASE_URL=https://dev.netcorp360.com/backend/asset
TRACKING_API_BASE_URL=https://dev.netcorp360.com/backend/tracking
# The NOTIFICATION bell hub, on notification-backend. helpdesk-backend's OWN
# ticket hub is NOT configured here: it is derived within the one service as
# helpdeskApiBaseUrl + /hubs/helpdesk (the path helpdesk-backend maps itself).
# The old single SIGNALR_HUB_URL named helpdesk's own hub and doubled as the
# navbar bell hub — two services, one ambiguous name.
NOTIFICATION_SIGNALR_HUB_URL=https://dev.netcorp360.com/backend/notification/hubs/notifications

MF_NAVBAR_URL=https://dev.netcorp360.com/mfs/packages/navbar
STANDALONE=true
BASE_PATH=/
#FEDERATION_DEBUG=true

# Observability
OBSERVABILITY_ENABLED=true
# Note: The logger appends /loki/api/v1/push, so don't include /loki in the URL
LOKI_URL=https://dev.netcorp360.com/monitoring
TRACING_ENABLED=true
# Note: Tempo OTLP HTTP endpoint (receives JSON traces)
TEMPO_ENDPOINT=https://dev.netcorp360.com/monitoring/tempo/v1/traces
# Excludes the auth host from W3C trace-header propagation (src/observability/config.ts
# turns this into config.observability.tracing.ignoreUrls). Without it, the OTel
# fetch instrumentation adds a `traceparent` header to the OIDC discovery-document
# fetch (https://auth.dev.netcorp360.com/realms/.../.well-known/openid-configuration).
# That header is cross-origin from any localhost dev port and auth.dev.netcorp360.com's
# CORS policy does not allowlist it, so the preflight fails with
# "Request header field traceparent is not allowed by Access-Control-Allow-Headers".
# oidc-client-ts needs that same discovery fetch to build the authorize URL, so
# BOTH the silent-SSO (prompt=none) probe AND the real signinRedirect() failed the
# same way — the login screen never appeared, just an endless
# "attempting silent SSO" / "Transient OIDC signal" loop. Confirmed live with a
# headless browser: unset this and the loop reproduces; set it and the app
# navigates cleanly to Keycloak's /protocol/openid-connect/auth with
# redirect_uri=http://localhost:<port>/.
TRACING_IGNORE_URLS_PATTERN=auth\.dev\.netcorp360\.com
METRICS_ENABLED=true

# Whitelabel feature flag - set to 'true' to enable whitelabel features
# When disabled, app will work normally without fetching whitelabel config
ENABLE_WHITELABEL=false

# Default platform domains that skip whitelabel config lookup (comma-separated)
DEFAULT_DOMAINS=dev.netcorp360.com,localhost
