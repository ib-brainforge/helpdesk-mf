{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "defaultBranch": "main",
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "jsxQuoteStyle": "double",
      "lineWidth": 80
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      "suspicious": {
        "noDuplicateFontNames": "off",
        "noExplicitAny": "warn",
        "noAssignInExpressions": "warn",
        "noArrayIndexKey": "warn",
        "noGlobalIsNan": "warn",
        "noConfusingVoidType": "warn"
      },

      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "warn",
        "useNodejsImportProtocol": "warn",
        "noUnusedTemplateLiteral": "warn",
        "noUselessElse": "warn",
        "useTemplate": "warn",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": ["fetch"]
          }
        }
      },

      "nursery": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "axios": "Import authorizedAxios from '@/state/authorizedAxios' (or use a generated @brainforgeau/*-client such as createHelpdeskApiClient). Raw axios is banned (Hard Gate #3, raw-fetch sweep 2026-07-06)."
            }
          }
        }
      },

      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noInvalidPositionAtImportRule": "warn"
      },

      "complexity": {
        "noForEach": "warn",
        "useLiteralKeys": "warn",
        "noUselessSwitchCase": "warn",
        "noUselessTernary": "warn",
        "useOptionalChain": "warn"
      },

      "a11y": {
        "noLabelWithoutControl": "warn",
        "useKeyWithClickEvents": "warn",
        "useButtonType": "warn",
        "useAltText": "warn",
        "noRedundantAlt": "warn",
        "useValidAriaProps": "warn",
        "noSvgWithoutTitle": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "useAriaPropsForRole": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "noAccessKey": "warn",
        "noAutofocus": "warn",
        "noInteractiveElementToNoninteractiveRole": "warn",
        "noNoninteractiveTabindex": "warn",
        "useAnchorContent": "warn",
        "useFocusableInteractive": "warn",
        "useSemanticElements": "warn",
        "noDistractingElements": "warn"
      },

      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "overrides": [
    {
      "include": ["src/state/authorizedAxios.ts", "src/utils/*ApiClient.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": "off"
          },
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ],
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      ".vscode/**/*",
      "node_modules/**/*",
      "dist/**/*",
      "src/api/helpdesk-client/**/*"
    ]
  }
}
